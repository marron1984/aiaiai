# Vercel Postgres（Vercelダッシュボードで自動設定される）
POSTGRES_PRISMA_URL="postgresql://..."
POSTGRES_URL_NON_POOLING="postgresql://..."

# Next.js
NEXT_PUBLIC_SITE_URL="https://your-domain.vercel.app"
NEXT_PUBLIC_SITE_NAME="aiaiai"

# Cron認証（Vercel Cronからの呼び出し検証用）
CRON_SECRET="your-cron-secret-here"

# GitHub API（オプション：認証すると5000回/時に増加）
GITHUB_TOKEN=""

# X API v2（速報補助、規約準拠必須: スクレイピング禁止）
# https://developer.x.com/en/portal/projects-and-apps から Bearer Token を取得
X_BEARER_TOKEN=""

# LLM要約API（P1で利用）
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""

# 管理者認証（MVP: 簡易パスワード認証）
ADMIN_PASSWORD="change-me-in-production"
